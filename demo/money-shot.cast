[0.4,"o","\u001b[2m$ npm run demo\u001b[0m\r\n"]
[0.48,"o","\r\n"]
[1.78,"o","\u001b[1m\u001b[36m=== STAGE 1 - RECONSTRUCT (no session) ==============================\u001b[0m\r\n"]
[1.86,"o","The stripped bundle gives up its whole surface, including routes/APIs a low-priv\r\n"]
[1.94,"o","user never sees. Note the hidden /api/admin/* endpoints - assembled from minified vars,\r\n"]
[2.02,"o","so a regex JS-miner misses them; Aperta recovers them from the AST.\r\n"]
[2.1,"o","\r\n"]
[2.7,"o","\u001b[2m$ aperta reconstruct lab/dist/assets --format endpoints\u001b[0m\r\n"]
[2.78,"o","GET /api/admin/users/{param}\r\n"]
[2.86,"o","GET /api/admin/users\r\n"]
[2.94,"o","POST /api/login\r\n"]
[3.02,"o","GET /api/me/orders\r\n"]
[3.1,"o","GET /api/orders/{param}\r\n"]
[3.18,"o","\r\n"]
[4.48,"o","\u001b[1m\u001b[36m=== STAGE 2 - DIFF (low-priv alice vs admin) ========================\u001b[0m\r\n"]
[4.56,"o","Reconstructed surface MINUS what alice can actually reach = the role-gated surface,\r\n"]
[4.64,"o","isolated. This is the delta no traffic-only tool can see (you never clicked it).\r\n"]
[4.72,"o","\r\n"]
[5.32,"o","\u001b[2m$ aperta diff --base http://localhost:5399 --js lab/dist/assets --session alice.json --session admin.json --format jsonl\u001b[0m\r\n"]
[5.4,"o","{\"session\":\"alice\",\"hidden\":\"GET /api/admin/users/{param}\"}\r\n"]
[5.48,"o","{\"session\":\"alice\",\"hidden\":\"GET /api/admin/users\"}\r\n"]
[5.56,"o","[alice/user] reachable:2 gated:3 hidden:2\r\n"]
[5.64,"o","[admin/admin] reachable:4 gated:1 hidden:0\r\n"]
[5.72,"o","findings: 0 BFLA/vertical-priv-esc, 2 BOLA candidate(s), 0 anon-reach\r\n"]
[5.8,"o","\r\n"]
[7.1,"o","\u001b[1m\u001b[36m=== STAGE 3 - PROVE (attacker alice vs victim bob, sibling oracle) ===\u001b[0m\r\n"]
[7.18,"o","GET /api/orders/{id} has no owner check. We confirm it NOT with a tuned response-diff\r\n"]
[7.26,"o","but with a contradiction inside the app: the sibling GET /api/me/orders is the app's\r\n"]
[7.34,"o","own statement of who owns what. alice pulls an order /api/me/orders attributes to bob,\r\n"]
[7.42,"o","with own-id=200 and nonexistent=404 controls holding in the same run.\r\n"]
[7.5,"o","\r\n"]
[8.1,"o","\u001b[2m$ aperta prove --base http://localhost:5399 --object /api/orders/{param} --sibling /api/me/orders --collection orders --attacker alice.json --victim bob.json\u001b[0m\r\n"]
[8.18,"o","{\r\n"]
[8.26,"o","  \"verdict\": \"CONFIRMED\",\r\n"]
[8.34,"o","  \"class\": \"BOLA\",\r\n"]
[8.42,"o","  \"confidence\": \"high\",\r\n"]
[8.5,"o","  \"method\": \"GET\",\r\n"]
[8.58,"o","  \"idKey\": \"id\",\r\n"]
[8.66,"o","  \"endpoint\": \"/api/orders/{param}\",\r\n"]
[8.74,"o","  \"oracle\": \"sibling-endpoint /api/me/orders (the app's own ownership statement)\",\r\n"]
[8.82,"o","  \"attacker\": \"alice\",\r\n"]
[8.9,"o","  \"victim\": \"bob\",\r\n"]
[8.98,"o","  \"evidence\": {\r\n"]
[9.06,"o","    \"attacker_owned\": [\r\n"]
[9.14,"o","      \"1001\",\r\n"]
[9.22,"o","      \"1002\"\r\n"]
[9.3,"o","    ],\r\n"]
[9.38,"o","    \"victim_owned\": [\r\n"]
[9.46,"o","      \"2001\",\r\n"]
[9.54,"o","      \"2002\"\r\n"]
[9.62,"o","    ],\r\n"]
[9.7,"o","    \"foreign_id_tested\": \"2001\",\r\n"]
[9.78,"o","    \"reproductions\": \"3/3\",\r\n"]
[9.86,"o","    \"attacker_get_foreign\": {\r\n"]
[9.94,"o","      \"status\": 200,\r\n"]
[10.02,"o","      \"body\": {\r\n"]
[10.1,"o","        \"id\": 2001,\r\n"]
[10.18,"o","        \"owner\": \"bob\",\r\n"]
[10.26,"o","        \"item\": \"Monitor\",\r\n"]
[10.34,"o","        \"total\": 300\r\n"]
[10.42,"o","      }\r\n"]
[10.5,"o","    },\r\n"]
[10.58,"o","    \"control_own_id\": \"1001\",\r\n"]
[10.66,"o","    \"control_own_result\": {\r\n"]
[10.74,"o","      \"status\": 200\r\n"]
[10.82,"o","    },\r\n"]
[10.9,"o","    \"control_nonexistent_result\": {\r\n"]
[10.98,"o","      \"status\": 404\r\n"]
[11.06,"o","    }\r\n"]
[11.14,"o","  },\r\n"]
[11.22,"o","  \"reason\": \"alice retrieved orders 2001, which /api/me/orders attributes to bob and not to alice, a contradiction in the app's own authorization reproduced 3/3 times, with own-id=200 and nonexistent=404 controls holding.\"\r\n"]
[11.3,"o","}\r\n"]
[11.38,"o","\r\n"]
[12.68,"o","\u001b[1m\u001b[36m=== STAGE 4 - ORACLES (auto-discover where the BOLA oracle applies) ===\u001b[0m\r\n"]
[12.76,"o","Aperta pairs each object endpoint with its self-scoped sibling list endpoint and\r\n"]
[12.84,"o","reports applicability honestly. The id format does not matter: the victim's REAL ids\r\n"]
[12.92,"o","are sourced from the victim's own list, so this is deterministic on uuids/slugs too.\r\n"]
[13,"o","\r\n"]
[13.6,"o","\u001b[2m$ aperta oracles --js lab/dist/assets --format text\u001b[0m\r\n"]
[13.68,"o","medium  /api/admin/users/{param}  ->  /api/admin/users\r\n"]
[13.76,"o","high    /api/orders/{param}  ->  /api/me/orders\r\n"]
[13.84,"o","sibling-oracle applies to 2/2 object endpoint(s) (100%)\r\n"]
[13.92,"o","\r\n"]
[15.22,"o","\u001b[1m\u001b[36m=== ATTACK SURFACE MAP (the one-shot visual) ========================\u001b[0m\r\n"]
[15.3,"o","[alice/user] reachable:2 gated:3 hidden:2\r\n"]
[15.38,"o","[admin/admin] reachable:4 gated:1 hidden:0\r\n"]
[15.46,"o","sibling-oracle applies to 2/2 object endpoint(s) (100%)\r\n"]
[15.54,"o","findings: 0 BFLA/vertical-priv-esc, 2 BOLA candidate(s), 0 anon-reach\r\n"]
[15.62,"o","\r\n"]
[15.7,"o","Self-contained HTML written: demo/attack-surface-map.html (10192 bytes)\r\n"]
